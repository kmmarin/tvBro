# Copy to keystore.properties (gitignored) to sign release builds locally.
# Paths are relative to the project root or absolute. Keep the keystore and passwords OUT of the repository.
# CI uses environment variables instead: TVBRO_KEYSTORE, TVBRO_KEYSTORE_PASSWORD, TVBRO_KEY_ALIAS, TVBRO_KEY_PASSWORD.
storeFile=/path/outside/the/repo/tvbro-release.jks
storePassword=CHANGE_ME
keyAlias=tvbro
keyPassword=CHANGE_ME
